# Copy this file to .env to change settings. Without a .env, the app uses the defaults below.

# Which model writes the answers: "ollama" (local, free) or "anthropic" (cloud, paid)
LLM_PROVIDER=ollama

# Local model, downloaded with: ollama pull <name>
OLLAMA_MODEL=llama3.2

# Only needed when LLM_PROVIDER=anthropic. Documents' matching excerpts are sent to Anthropic.
# ANTHROPIC_API_KEY=paste-your-key-here
# ANTHROPIC_MODEL=claude-opus-5-5
